# Nginx reverse proxy config for PUBLICAPPS — containerized with ModSecurity WAF
# Base image: owasp/modsecurity-crs:nginx-alpine
#   - nginx + ModSecurity v3 connector + OWASP CRS are built together (ABI-matched),
#     so no more worker SIGSEGV from a mismatched hand-built module.
# - Proxies /kcauth/* to Keycloak, /rewardtech/api/ to backend, / to the SPA(s)
# - Enforces HTTPS, CORS, CSP, rate limiting, and ModSecurity
load_module modules/ngx_http_headers_more_filter_module.so;
load_module modules/ngx_http_modsecurity_module.so;

user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}
http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # ---- ModSecurity (enabled globally) ----
    # setup.conf is generated by the CRS image entrypoint and pulls in
    # modsecurity.conf + crs-setup.conf + all CRS rules. Our endpoint-specific
    # overrides load last so they win.
    # Verify in the image:  docker exec <c> ls /etc/modsecurity.d/
    modsecurity on;
    modsecurity_rules_file /etc/modsecurity.d/setup.conf;
    modsecurity_rules_file /etc/modsecurity.d/modsecurity-override.conf;

    sendfile        on;
    keepalive_timeout  65;
    server_names_hash_bucket_size 128;
    client_max_body_size 50M;
    large_client_header_buffers 4 16k;
    server_tokens off;

    # Rate limiting (per client IP)
    limit_req_status 429;
    limit_req_zone $binary_remote_addr zone=login:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=context:10m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=api:10m rate=60r/s;

    # CORS: only echo Origin when it matches a known app host
    map $http_origin $cors_origin {
        default "";
        "https://envestnet.rewardtech.in"     $http_origin;
        "https://store.rewardtech.in"         $http_origin;
        "https://letssaythankyou.com"         $http_origin;
        "https://www.letssaythankyou.com"     $http_origin;
        "https://thebigdealz.com"             $http_origin;
        "https://www.thebigdealz.com"         $http_origin;
    }

    # Allow-Credentials only when Origin was whitelisted ($cors_origin non-empty)
    map $cors_origin $cors_credentials {
        default "";
        "~^https://" "true";
    }

    # React app upstream port by host (avoid variable proxy_pass + if chains)
    map $host $app_backend_port {
        default 3002;
        letssaythankyou.com 3003;
        www.letssaythankyou.com 3003;
        store.rewardtech.in 3001;
    }

    # HTTPS server
    server {
        listen 443 ssl;
        server_name www.letssaythankyou.com letssaythankyou.com store.rewardtech.in envestnet.rewardtech.in;
        location ^~ /.well-known/acme-challenge/ {
     	 root /var/www/certbot;
     	 default_type "text/plain";
     	 try_files $uri =404;
   	}
	    ssl_certificate     /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;

        # Security headers (HTTPS only; more_set_headers applies in all locations)
        more_set_headers "Strict-Transport-Security: max-age=31536000; includeSubDomains";
        more_set_headers "X-Content-Type-Options: nosniff";
        more_set_headers "Referrer-Policy: strict-origin-when-cross-origin";
        more_set_headers "Permissions-Policy: geolocation=(), microphone=(), camera=()";

        # CORS handled at Nginx — $cors_origin is empty unless Origin matches the map
        add_header 'Access-Control-Allow-Origin' $cors_origin always;
        add_header 'Vary' 'Origin' always;
        add_header 'Access-Control-Allow-Credentials' $cors_credentials always;
        add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
        add_header 'Content-Security-Policy' "default-src * data: blob:; script-src * 'unsafe-inline' data: blob:; style-src * 'unsafe-inline' data: blob:; img-src * data: blob:; connect-src * ws: wss:; frame-src *; font-src * data:;" always;

    # Note: Preflight (OPTIONS) responses are handled inside each location
        # Proxy /kcauth/* to Keycloak
        location /kcauth/ {
            limit_req zone=login burst=100 nodelay;
            # Preflight short-circuit (whitelisted Origin only; no nested if — nginx limitation)
            set $cors_preflight_deny "";
            if ($request_method = OPTIONS) {
                set $cors_preflight_deny "O";
            }
            if ($cors_origin = "") {
                set $cors_preflight_deny "${cors_preflight_deny}E";
            }
            if ($cors_preflight_deny = OE) {
                return 403;
            }
            if ($request_method = OPTIONS) {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' $cors_credentials always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_pass http://10.0.2.4:8088/kcauth/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Stream Keycloak responses — prevents ModSecurity from buffering large
            # HTML pages and corrupting chunked encoding.
            proxy_buffering off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;
        }

        # Context bootstrap — plain-text POST; WAF off for this one path only.
        # CRS rule 920420 blocks Content-Type: text/plain, scoring 949110 -> 403.
        # Exact-match location wins regardless of order, so only this URL skips the WAF.
        location = /rewardtech/api/admin/context/findByIncomingURL {
            modsecurity off;
            limit_req zone=api burst=50 nodelay;
            proxy_pass http://10.0.2.4:8080/rewardtech/api/admin/context/findByIncomingURL;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;
        }

              # Proxy to server call
        location /rewardtech/api/ {
            limit_req zone=api burst=50 nodelay;
            # Preflight short-circuit (whitelisted Origin only; no nested if — nginx limitation)
            set $cors_preflight_deny "";
            if ($request_method = OPTIONS) {
                set $cors_preflight_deny "O";
            }
            if ($cors_origin = "") {
                set $cors_preflight_deny "${cors_preflight_deny}E";
            }
            if ($cors_preflight_deny = OE) {
                return 403;
            }
            if ($request_method = OPTIONS) {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' $cors_credentials always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_pass http://10.0.2.4:8080/rewardtech/api/;

            # SSE Support
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 24h;
            proxy_set_header Connection '';
            proxy_http_version 1.1;
            chunked_transfer_encoding on;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;
        }
        # Proxy everything else to React app
        location /store/ {
            # Preflight short-circuit (whitelisted Origin only; no nested if — nginx limitation)
            set $cors_preflight_deny "";
            if ($request_method = OPTIONS) {
                set $cors_preflight_deny "O";
            }
            if ($cors_origin = "") {
                set $cors_preflight_deny "${cors_preflight_deny}E";
            }
            if ($cors_preflight_deny = OE) {
                return 403;
            }
            if ($request_method = OPTIONS) {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' $cors_credentials always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_pass http://10.0.2.4:3001/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;

        }
        # Proxy everything else to React app
        location / {
            # Preflight short-circuit (whitelisted Origin only; no nested if — nginx limitation)
            set $cors_preflight_deny "";
            if ($request_method = OPTIONS) {
                set $cors_preflight_deny "O";
            }
            if ($cors_origin = "") {
                set $cors_preflight_deny "${cors_preflight_deny}E";
            }
            if ($cors_preflight_deny = OE) {
                return 403;
            }
            if ($request_method = OPTIONS) {
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' $cors_credentials always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }

            # Stream SPA responses; avoids buffering huge/corrupt Content-Length.
            proxy_buffering off;
            proxy_cache off;
            proxy_http_version 1.1;
            proxy_set_header Connection "";

            proxy_pass http://10.0.2.4:$app_backend_port;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;

       }
    }
    # HTTP to HTTPS redirect
    server {
        listen 80;
        server_name www.letssaythankyou.com www.thebigdealz.com letssaythankyou.com thebigdealz.com store.rewardtech.in envestnet.rewardtech.in;
        location ^~ /.well-known/acme-challenge/ {
      		root /var/www/certbot;
     		default_type "text/plain";
      		try_files $uri =404;
   	 }
	location / { return 301 https://$host$request_uri; }
    }
}
