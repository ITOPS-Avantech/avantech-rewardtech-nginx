# Nginx reverse proxy config for local/dev with HTTPS
# - Proxies /auth/* to Keycloak container
# - Proxies / (root) to React app container
# - Enforces HTTPS, sets CORS and CSP headers
load_module modules/ngx_http_headers_more_filter_module.so;
load_module modules/ngx_http_modsecurity_module.so;
#user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}
http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    modsecurity on; 
    modsecurity_rules_file /etc/modsecurity/modsecurity.conf;
    sendfile        on;
    keepalive_timeout  65;
    server_names_hash_bucket_size 128;
    client_max_body_size 50M;
    server_tokens off;

    # Rate limiting (per client IP)
    limit_req_status 429;
    limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=context:10m rate=30r/m;
    limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;

    # CORS: only echo Origin when it matches a known app host (see server block below)
    map $http_origin $cors_origin {
        default "";
        "https://envestnet.rewardtech.in"     $http_origin;
        "https://store.rewardtech.in"         $http_origin;
        "https://letssaythankyou.com"         $http_origin;
        "https://www.letssaythankyou.com"     $http_origin;
        "https://thebigdealz.com"             $http_origin;
        "https://www.thebigdealz.com"         $http_origin;
    }

    # Strict CSP for React SPAs only (not applied to /kcauth/ or /rewardtech/api/)
    map $host $spa_csp {
        default "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' wss: https://checkout.razorpay.com https://api.razorpay.com https://api.linkedin.com https://www.linkedin.com; frame-src 'self' https://checkout.razorpay.com; form-action 'self'; frame-ancestors 'self';";
    }

    # HTTPS server
    server {
        listen 443 ssl;
        server_name www.letssaythankyou.com www.thebigdealz.com letssaythankyou.com thebigdealz.com store.rewardtech.in envestnet.rewardtech.in;
        location ^~ /.well-known/acme-challenge/ {
     	 root /var/www/certbot;
     	 default_type "text/plain";
     	 try_files $uri =404;
   	}
	ssl_certificate     /etc/nginx/ssl/certs/server.crt;
        ssl_certificate_key /etc/nginx/ssl/private/server.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;

        # Security headers (HTTPS only)
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

        # CORS — only for whitelisted Origin ($cors_origin from map in http {})
        if ($cors_origin != "") {
            add_header 'Access-Control-Allow-Origin' $cors_origin always;
            add_header 'Vary' 'Origin' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
            add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
        }

    # Note: Preflight (OPTIONS) responses are handled inside each location
        # Proxy /auth/* to Keycloak (no custom CSP — Keycloak serves its own pages)
        location /kcauth/ {
            limit_req zone=login burst=20 nodelay;
            # Preflight short-circuit (whitelisted Origin only)
            if ($request_method = OPTIONS) {
                if ($cors_origin = "") {
                    return 403;
                }
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_pass http://10.0.2.4:8088/kcauth/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;
        }

              # Proxy to server call
        location /rewardtech/api/ {
            limit_req zone=api burst=50 nodelay;
            # Preflight short-circuit (whitelisted Origin only)
            if ($request_method = OPTIONS) {
                if ($cors_origin = "") {
                    return 403;
                }
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_pass http://10.0.2.4:8080/rewardtech/api/;
            
            # SSE Support
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 24h;
            proxy_set_header Connection '';
            proxy_http_version 1.1;
            chunked_transfer_encoding on;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;
        }
        # Proxy everything else to React app
        location /store/ {
            # Preflight short-circuit (whitelisted Origin only)
            if ($request_method = OPTIONS) {
                if ($cors_origin = "") {
                    return 403;
                }
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_pass http://10.0.2.4:3001/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;

            add_header Content-Security-Policy $spa_csp always;
        }
        # Proxy everything else to React app
        location / {
            # Preflight short-circuit (whitelisted Origin only)
            if ($request_method = OPTIONS) {
                if ($cors_origin = "") {
                    return 403;
                }
                add_header 'Access-Control-Allow-Origin' $cors_origin always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
	    # Route letssaythanku.avantech.com to port 3003
	                
            set $backend "3002";
            
            # Route letssaythankyou.rewardtech.in to port 3003
            if ($host ~* ^(www\.)?letss+aythankyou\.com$) {
                set $backend "3003";
            }
	    if ($host = letssaythankyou.com) {
                set $backend "3003";
            
	    }
	    if ($host = store.rewardtech.in) {
                set $backend "3001";
            }

	    proxy_pass http://10.0.2.4:$backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;

            add_header Content-Security-Policy $spa_csp always;
       }
    }
    # HTTP to HTTPS redirect
    server {
        listen 80;
        server_name www.letssaythankyou.com www.thebigdealz.com letssaythankyou.com thebigdealz.com store.rewardtech.in envestnet.rewardtech.in;
        location ^~ /.well-known/acme-challenge/ {
      		root /var/www/certbot;
     		default_type "text/plain";
      		try_files $uri =404;
   	 }
	location / { return 301 https://$host$request_uri; }
    }
}

