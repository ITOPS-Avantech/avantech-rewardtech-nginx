# Nginx reverse proxy config for local/dev with HTTPS
# - Proxies /auth/* to Keycloak container
# - Proxies / (root) to React app container
# - Enforces HTTPS, sets CORS and CSP headers

user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;
    client_max_body_size 50M;

    # HTTP config
    server {
        listen 80;
        server_name localhost avantechvarsity.campustore.in avantech-rewardportal.centralindia.cloudapp.azure.com itsabigdeal.campustore.in rewards.rewardtech.in letssaythankyou.rewardtech.in www.itsabigdeal.co.in letssaythanku.avantech.com;

         # CORS and CSP headers
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' '*' always;
        add_header 'Access-Control-Allow-Headers' '*' always;
        add_header 'Content-Security-Policy' "default-src * data: blob:; script-src * 'unsafe-inline' 'unsafe-eval' data: blob:; style-src * 'unsafe-inline' data: blob:; img-src * data: blob:; connect-src * ws: wss:; frame-src *; font-src * data:;" always;


        location /kcauth/ {
            proxy_pass http://host.docker.internal:8088/kcauth/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
        }
        # Proxy to server call
        location /rewardtech/api/ {
            proxy_pass http://host.docker.internal:8080/rewardtech/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
        }
        # Proxy /store to React app 2 (port 3001)
        location /store/ {
            proxy_pass http://host.docker.internal:3001/store/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;

        }
        # Proxy everything else to React app
        location / {
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            
            # Route letssaythankyou.rewardtech.in to port 3003
            if ($host = letssaythankyou.rewardtech.in) {
                proxy_pass http://host.docker.internal:3003;
                break;
            }
            
            proxy_pass http://host.docker.internal:3000;
       }


    }
}
