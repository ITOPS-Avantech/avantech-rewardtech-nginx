# Nginx reverse proxy config for local/dev with HTTPS
# - Proxies /auth/* to Keycloak container
# - Proxies / (root) to React app container
# - Enforces HTTPS, sets CORS and CSP headers

user  nginx;
worker_processes  auto;

error_log  /var/log/nginx/error.log warn;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}
http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile        on;
    keepalive_timeout  65;
    server_names_hash_bucket_size 128;
    client_max_body_size 50M;

    # HTTPS server
    server {
        listen 443 ssl;
        server_name demo.envestnet.rewardtech.in demo.store.rewardtech.in demo.letssaythankyou.com demo.rewardtech.in demo.thebigdealz.com itsabigdeal.campustore.in letssaythankyou.rewardtech.in rewards.rewardtech.in www.itsabigdeal.co.in;
        location ^~ /.well-known/acme-challenge/ {
     	 root /var/www/certbot;
     	 default_type "text/plain";
     	 try_files $uri =404;
   	}
	ssl_certificate     /etc/ssl/certs/server.crt;
        ssl_certificate_key /etc/ssl/private/server.key;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;


        # CORS handled at Nginx (Option B)
        add_header 'Access-Control-Allow-Origin' "$http_origin" always;
        add_header 'Vary' 'Origin' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
        add_header 'Content-Security-Policy' "default-src * data: blob:; script-src * 'unsafe-inline' 'unsafe-eval' data: blob:; style-src * 'unsafe-inline' data: blob:; img-src * data: blob:; connect-src * ws: wss:; frame-src *; font-src * data:;" always;

    # Note: Preflight (OPTIONS) responses are handled inside each location
        # Proxy /auth/* to Keycloak
        location /kcauth/ {
            # Preflight short-circuit
            if ($request_method = OPTIONS) {
                add_header 'Access-Control-Allow-Origin' "$http_origin" always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_pass http://172.17.0.1:8088/kcauth/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;
        }
              # Proxy to server call
        location /rewardtech/api/ {
            # Preflight short-circuit
            if ($request_method = OPTIONS) {
                add_header 'Access-Control-Allow-Origin' "$http_origin" always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_pass http://172.17.0.1:8080/rewardtech/api/;
            
            # SSE Support
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 24h;
            proxy_set_header Connection '';
            proxy_http_version 1.1;
            chunked_transfer_encoding on;

            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;
        }
        # Proxy everything else to React app
        location /store/ {
            # Preflight short-circuit
            if ($request_method = OPTIONS) {
                add_header 'Access-Control-Allow-Origin' "$http_origin" always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
            proxy_pass http://172.17.0.1:3001/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;

        }
        # Proxy everything else to React app
        location / {
            # Preflight short-circuit
            if ($request_method = OPTIONS) {
                add_header 'Access-Control-Allow-Origin' "$http_origin" always;
                add_header 'Vary' 'Origin' always;
                add_header 'Access-Control-Allow-Credentials' 'true' always;
                add_header 'Access-Control-Allow-Methods' 'GET,POST,PUT,PATCH,DELETE,OPTIONS' always;
                add_header 'Access-Control-Allow-Headers' 'Authorization,Content-Type,Accept,Origin,User-Agent,DNT,Cache-Control,X-Requested-With,If-Modified-Since,Keep-Alive' always;
                add_header 'Access-Control-Max-Age' 86400 always;
                return 204;
            }
	    # Route letssaythanku.avantech.com to port 3003
	                
            set $backend "3000";


            # Route letssaythankyou.rewardtech.in to port 3003
            if ($host = demo.letssaythankyou.com) {
                set $backend "3003";
            }
	    if ($host = demo.rewardtech.in) {
	    	set $backend "3002";
	    }
		
            if ($host = demo.envestnet.rewardtech.in) {
                set $backend "3002";
            }	    
            if ($host = demo.store.rewardtech.in) {
                set $backend "3001";
            }
	    proxy_pass http://172.17.0.1:$backend;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_ssl_verify off;
            # Avoid duplicate CORS headers from upstream
            proxy_hide_header Access-Control-Allow-Origin;
            proxy_hide_header Access-Control-Allow-Credentials;
            proxy_hide_header Access-Control-Allow-Headers;
            proxy_hide_header Access-Control-Allow-Methods;

       }
    }
    # HTTP to HTTPS redirect
    server {
        listen 80;
        server_name demo.letssaythankyou.com demo.rewardtech.in demo.thebigdealz.comavantechvarsity.campustore.in itsabigdeal.campustore.in www.itsabigdeal.co.in;
        location ^~ /.well-known/acme-challenge/ {
      		root /var/www/certbot;
     		default_type "text/plain";
      		try_files $uri =404;
   	 }
	location / { return 301 https://$host$request_uri; }
    }
}
